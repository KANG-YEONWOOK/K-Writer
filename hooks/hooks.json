{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/writing_method.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/writing_method.py\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/writing_method.py\" --subagent || python \"${CLAUDE_PLUGIN_ROOT}/hooks/writing_method.py\" --subagent"
          }
        ]
      }
    ]
  }
}
